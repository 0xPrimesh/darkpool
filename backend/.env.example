# Copy to .env and fill in.

# "localnet" (arcium test / docker) or "devnet"
CLUSTER=devnet

# Dedicated devnet RPC. The public api.devnet.solana.com drops txs under load.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Payer / upgrade authority used by scripts and the server
WALLET_PATH=~/.config/solana/id.json

# Arcium cluster offset: 456 = devnet cluster. Localnet is handled by `arcium test`.
CLUSTER_OFFSET=456

# Server port for the frontend API
PORT=8787

# Markets to run (see scripts/lib/markets.ts). Each has its own base mock
# mint, settlement pool and Pyth feed; the feed is registered on-chain per
# pool so a batch can only ever be priced with its own market's feed.
MARKETS=SOL,NVDA
# Override a market's Pyth feed id (hex). Pyth's 24/7 NVDA index is
# a470c4ac46f44b547b2cba52338f311fb642b79375ce5f0cfd5cb5b99227b852; the
# default b1073854... is the regular session feed (09:30-16:00 ET only).
# NVDA_FEED_ID=

# Which price account `match_orders` is given. The darkpool program reads
# and validates it ON-CHAIN (owner, the market's feed id, <= 60 s old,
# confidence <= 1 %); no process ever sends a price number to the chain.
#   pyth  the Pyth push-oracle account of each market's feed (shard 0) under
#         the upgraded (Aug 2026) receiver rec2HHDD... SOL/USD's
#         (7AviUf9nL62mcxNbQGKm4nKDQnPjswo6c5MX4D57HmyE) is sponsored by
#         Pyth on devnet; NVDA/USD's is maintained by this coordinator.
#   mock  localnet only: Pyth-shaped accounts written by set_mock_price with
#         REFERENCE_PRICE. Needs the darkpool `mock-oracle` cargo feature,
#         which the devnet build does not have.
PRICE_SOURCE=pyth
REFERENCE_PRICE=150000000

# If a market's account is older than this when a batch is matched, the
# coordinator fetches the latest signed update from Hermes and writes it into
# the same push account through the Pyth receiver (the program verifies it
# exactly like a sponsored update).
PYTH_SPONSORED_MAX_AGE_SEC=30
# Hermes requires an API key since the Pyth Core upgrade (Aug 2026): sign up
# at https://pythdata.app/signup (free trial). Without a key the coordinator
# can only wait up to PYTH_WAIT_FRESH_SEC for sponsored feeds (SOL) and
# reports non-sponsored markets (NVDA) as not tradable.
# Pyth's upgraded endpoint; https://hermes.pyth.network still works with a key.
HERMES_URL=https://pyth.dourolabs.app/hermes
HERMES_API_KEY=
PYTH_WAIT_FRESH_SEC=240
# While an equity market is open, refresh its (non-sponsored) feed this often.
PYTH_SELF_REFRESH_MS=45000

# Collateral tier for coordinator batches (all markets). Every party escrows
# SOL_BUCKET base units (SOL-mock / NVDA-mock) AND SOL_BUCKET x reference x
# ESCROW_BOUND_PCT/100 USDC-mock, whichever side it is on. Orders larger
# than SOL_BUCKET cannot fill.
SOL_BUCKET=1
ESCROW_BOUND_PCT=125

# Batch window
BATCH_WINDOW_MS=30000
